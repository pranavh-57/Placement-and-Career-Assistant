# --- LLM ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- MCP: GitHub tool ---
# Optional. Unauthenticated GitHub API works but is rate-limited (60 req/hr).
# Create a token at https://github.com/settings/tokens for higher limits (no scopes needed for public data).
GITHUB_TOKEN=

# --- MCP: Job/web search tool ---
# Uses Tavily (https://tavily.com) for live web/job search. Falls back to a
# curated local job-listings file (data/knowledge_base/sample_jobs.json) if unset.
TAVILY_API_KEY=

# --- App ---
CHROMA_PERSIST_DIR=./data/chroma
CORS_ORIGINS=http://localhost:5173
