# --- LLM ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=40
LLM_MAX_ATTEMPTS=2

# --- MCP: GitHub tool ---
# Optional. Unauthenticated GitHub API works but is rate-limited (60 req/hr).
# Create a token at https://github.com/settings/tokens for higher limits (no scopes needed for public data).
GITHUB_TOKEN=

# --- MCP: Job/web search tool ---
# Uses Tavily (https://tavily.com) for live web/job search. Falls back to a
# curated local job-listings file (data/knowledge_base/sample_jobs.json) if unset.
TAVILY_API_KEY=

# --- App ---
CHROMA_PERSIST_DIR=./data/chroma
# Production: set to your Vercel URL, e.g. https://your-app.vercel.app (no localhost).
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MAX_UPLOAD_MB=5

# --- Auth ---
# --- Email OTP (https://www.resend.com: free, verify one sender address) ---
# Leave resend_API_KEY empty in development: the OTP is printed in the backend log.
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=Wayfind <onboarding@resend.dev>
OTP_EXPIRE_MINUTES=10
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving this placeholder is rejected when ENVIRONMENT=production.
JWT_SECRET_KEY=change-me-in-.env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./data/app.db
